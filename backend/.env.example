# ---- VOLT backend configuration (copy to .env; never commit real values) ----

# development | test | production
# production refuses to start with mock inference, weak flag secret,
# dev database password, or wildcard CORS.
VOLT_ENV=development

# Postgres
VOLT_DATABASE_URL=postgresql://volt:volt_dev_password@127.0.0.1:5432/volt
# docker-compose reads this instead of a full URL:
VOLT_DB_PASSWORD=change-me

# Inference: any OpenAI-compatible /chat/completions endpoint.
# Local Ollama is the reference deployment (see docs/DEPLOYMENT.md).
VOLT_PROVIDER=openai_compatible
VOLT_BASE_URL=http://127.0.0.1:11434/v1
VOLT_MODEL=qwen3:8b
VOLT_OLLAMA_MODEL=qwen3:8b
VOLT_API_KEY=
# Pin non-thinking mode where the server supports chat_template_kwargs
# (vLLM). For Ollama, bake non-thinking into a Modelfile instead; see
# docs/DEPLOYMENT.md.
VOLT_EXTRA_BODY=

# Generation settings are pinned per challenge version in the database;
# these are fallbacks/caps.
VOLT_TEMPERATURE=0.2
VOLT_TOP_P=0.9
VOLT_MAX_TOKENS=400
VOLT_REQUEST_TIMEOUT=90

# Shared inference controls
VOLT_INFERENCE_CONCURRENCY=2
VOLT_INFERENCE_QUEUE_MAX=16

# Gameplay limits
VOLT_MAX_MESSAGE_CHARS=12000
VOLT_MAX_CONVERSATION_TURNS=60
VOLT_RATE_LIMIT_TURNS_PER_MINUTE=12
VOLT_RATE_LIMIT_BURST=5
VOLT_ACTIVITY_WINDOW_MINUTES=5

# Auth
VOLT_SESSION_TTL_HOURS=168
VOLT_REQUIRE_EMAIL_VERIFICATION=false
# Comma-separated emails that receive the admin role at registration.
VOLT_ADMIN_EMAILS=

# Secrets — REQUIRED in production. Generate: openssl rand -hex 32
VOLT_FLAG_SECRET=

# Explicit browser origins (the Vercel frontend URL in production).
VOLT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
