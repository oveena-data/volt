# ---- VOLT backend configuration ----
# Copy to .env and edit. All values have safe defaults so the game runs
# with NO API key at all (using the built-in deterministic "mock" provider).

# Which LLM backend to use: "mock" | "openai_compatible"
#   mock             -> no network, no key, deterministic. Good for dev/CI/demos.
#   openai_compatible-> any OpenAI-compatible /chat/completions endpoint, e.g.
#                         - Ollama   (local, free):  http://localhost:11434/v1
#                         - Groq     (free tier):    https://api.groq.com/openai/v1
#                         - OpenRouter (free models): https://openrouter.ai/api/v1
VOLT_PROVIDER=mock

# Endpoint + model used when VOLT_PROVIDER=openai_compatible
VOLT_BASE_URL=http://localhost:11434/v1
VOLT_MODEL=llama3.1:8b
# API key for the endpoint. Leave blank for Ollama. Set for Groq/OpenRouter.
VOLT_API_KEY=

# Generation controls
VOLT_TEMPERATURE=0.3
VOLT_MAX_TOKENS=512
VOLT_REQUEST_TIMEOUT=60

# Where the SQLite DB lives (scores, leaderboard, poisoned memory for L8)
VOLT_DB_PATH=volt.db

# CORS: the frontend dev origin
VOLT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
